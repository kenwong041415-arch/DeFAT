{
  "name": "defat-firestore-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules tests for firestore.rules, run against the Firestore emulator.",
  "scripts": {
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-defat \"npm test\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0"
  }
}
